{
	"schemaVersion": 1,
	"id": "container-search",
	"version": "${version}",
	"name": "Container Search",
	"description": "Container Search is a mod that allows you to index and organize container contents under one place",
	"authors": [
		"Vethre"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/V3thre/Container-Search",
		"issues": "https://github.com/V3thre/Container-Search/issues"
	},
	"license": "CC0-1.0",
	"icon": "assets/container-search/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"veth.containersearch.ContainerSearch"
		],
		"client": [
			"veth.containersearch.client.ContainerSearchClient"
		],
		"modmenu": [
			"veth.containersearch.client.ModMenuIntegration"
		]
	},
	"mixins": [
		"container-search.mixins.json",
		{
			"config": "container-search.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	},
	"suggests": {
		"modmenu": "*"
	}
}